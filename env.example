# Copy to .env on the server and keep it out of git.
#
#     cp env.example .env && chmod 600 .env
#
# Every value has a working default, so an empty file is a valid file. Only the
# Bluesky credentials unlock anything that does not already work.

# The port inside the container and on the loopback interface. Not 8000: that
# is the first thing a scanner tries, and it collides with half the things one
# ends up running on a box. Change it freely, nginx is the only client.
FACTNET_PORT=8347

# One uvicorn worker holds one copy of the weights, about 2.1 GB. Two workers
# double that before serving a single extra request, so raise this only if the
# box has the memory and the traffic to justify it.
FACTNET_WORKERS=1
FACTNET_THREADS=2

FACTNET_LOG_LEVEL=info

# Ceiling and share for the container. The measured peak is 2.1 GB.
FACTNET_MEM_LIMIT=4g
FACTNET_CPUS=3.0

# Leave empty. The page and the API are served from the same origin, so the
# browser never makes a cross-origin request and nothing has to be permitted.
# Set it only if you ever split the front end onto another host, as a
# comma-separated list of full origins.
FACTNET_CORS_ORIGINS=

# Only the "Bluesky link" input needs these: fetching a live cascade calls an
# authenticated endpoint. Everything else, the four stored cascades, pasted
# text, pasted cascades, works without them.
#
# Use an application password created in the Bluesky settings, never the
# account password. It is revocable on its own.
# BSKY_IDENTIFIER=handle.bsky.social
# BSKY_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx
